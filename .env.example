# Salin ke .env lalu isi nilainya:  cp .env.example .env
# NEXT_PUBLIC_* di-inline saat build → restart `yarn dev` / rebuild image setelah mengubahnya.

# ─── Backend API ─────────────────────────────────────────────────────────────
# Base URL backend Go, TANPA /v1 (path /v1/... sudah ditulis di kode).
# Dipakai proxy /api/proxy, serverApi (sitemap, metadata halaman game), dan rewrite WebSocket /api/ws.
#   dev   : https://dev-api.pakargaming.id
#   lokal : http://localhost:4001
#   prod  : https://api.pakargaming.id
NEXT_PUBLIC_API_BASE_URL=https://dev-api.pakargaming.id

# ─── Site ────────────────────────────────────────────────────────────────────
# URL publik frontend ini, tanpa trailing slash. Dipakai untuk URL di sitemap.xml dan
# header X-Forwarded-Origin / X-Forwarded-Referer pada POST yang diteruskan proxy ke backend.
NEXT_SITE_BASE_URL=http://localhost:3000

# ─── Enkripsi payload ────────────────────────────────────────────────────────
# Kunci AES untuk body POST/PUT/PATCH antara browser dan proxy Next.js. Proxy mendekripsi
# sebelum meneruskan ke backend, jadi backend tidak perlu tahu kunci ini.
# BUKAN kontrol keamanan: nilainya ikut terkirim ke browser lewat CryptoProvider (layout.tsx)
# dan proxy tetap menerima body polos. Jangan isi dengan rahasia yang dipakai di tempat lain.
# Generate: openssl rand -hex 32
ENCRYPT_SECRET_KEY=
# Belum dibaca kode (hanya diteruskan di Dockerfile/CI). Samakan dengan ENCRYPT_SECRET_KEY.
NEXT_PUBLIC_ENCRYPT_KEY=

# ─── Cloudflare Turnstile (anti-bot login/daftar/lupa password) ──────────────
# Buat widget di dash.cloudflare.com → Turnstile (mode "Managed"), daftarkan domain situs.
# Aktif hanya kalau KEDUANYA terisi; kosong = form auth berjalan tanpa captcha.
# Kunci uji coba (selalu lolos): site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
# Site key di-inline saat build → di Docker/CI WAJIB jadi build-arg (secret NEXT_PUBLIC_TURNSTILE_SITE_KEY_PROD/_DEV).
# Secret terisi tapi site key kosong → Turnstile mati; server menulis error saat start.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Rahasia, hanya dibaca proxy di server. Di Docker diteruskan lewat `environment:` (runtime), bukan build arg.
TURNSTILE_SECRET_KEY=

# ─── Opsional ────────────────────────────────────────────────────────────────
# Google Analytics 4 (G-XXXXXXXXXX). Kosong = GA tidak dimuat.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Logo footer. Biarkan ter-comment untuk memakai default. Jangan di-set kosong:
# string kosong tidak memicu fallback `??` di Footer/config.ts, jadi logonya hilang.
# NEXT_PUBLIC_FOOTER_LOGO_URL=https://s3.nevaobjects.id/image-dev/uploads/20260121141804.png

# ─── IP pembeli & kunci proxy (runtime, server-only) ─────────────────────────
# Header yang DITIMPA edge proxy (nginx/Caddy di host) dengan IP koneksi pembeli. Nilainya divalidasi
# (harus IP); tidak ada / tidak sah → backend menerima "unknown". Untuk x-forwarded-for dipakai entri
# paling kanan. nginx: `proxy_set_header X-Real-IP $remote_addr;`. Kosong = x-real-ip.
CLIENT_IP_HEADER=x-real-ip
# Rahasia bersama dengan backend (STOREFRONT_PROXY_SECRET di topup-be, nilainya sama). Dikirim proxy
# sebagai header X-Storefront-Key; backend hanya memercayai X-Client-IP dari request yang membawanya.
# JANGAN diberi prefix NEXT_PUBLIC_. Generate: openssl rand -hex 32. Kosong = tidak dikirim (log peringatan).
STOREFRONT_PROXY_SECRET=

# ─── Host gambar tambahan (opsional, build-time) ─────────────────────────────
# Hostname persis (tanpa wildcard), dipisah koma, yang gambarnya boleh dioptimasi next/image —
# tambahan dari daftar di src/config/images.ts (mis. bucket/CDN Spaces production kalau berbeda).
# NEXT_PUBLIC_IMAGE_HOSTS=
