# Salin ke .env lalu isi nilainya:  cp .env.example .env
# NEXT_PUBLIC_* di-inline saat build → restart `yarn dev` / rebuild image setelah mengubahnya.

# ─── Backend API ─────────────────────────────────────────────────────────────
# Base URL backend Go, TANPA /v1 (path /v1/... sudah ditulis di kode).
# Dipakai proxy /api/proxy, serverApi (sitemap, metadata halaman game), dan rewrite WebSocket /api/ws.
#   dev   : https://dev-api.pakargaming.id
#   lokal : http://localhost:4001
#   prod  : https://api.pakargaming.id
NEXT_PUBLIC_API_BASE_URL=https://dev-api.pakargaming.id

# ─── Site ────────────────────────────────────────────────────────────────────
# URL publik frontend ini, tanpa trailing slash. Dipakai untuk URL di sitemap.xml dan
# header X-Forwarded-Origin / X-Forwarded-Referer pada POST yang diteruskan proxy ke backend.
NEXT_SITE_BASE_URL=http://localhost:3000

# ─── Enkripsi payload ────────────────────────────────────────────────────────
# Kunci AES untuk body POST/PUT/PATCH antara browser dan proxy Next.js. Proxy mendekripsi
# sebelum meneruskan ke backend, jadi backend tidak perlu tahu kunci ini.
# Catatan: nilainya ikut terkirim ke browser lewat CryptoProvider (layout.tsx).
# Generate: openssl rand -hex 32
ENCRYPT_SECRET_KEY=
# Belum dibaca kode (hanya diteruskan di Dockerfile/CI). Samakan dengan ENCRYPT_SECRET_KEY.
NEXT_PUBLIC_ENCRYPT_KEY=

# ─── Opsional ────────────────────────────────────────────────────────────────
# Google Analytics 4 (G-XXXXXXXXXX). Kosong = GA tidak dimuat.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Logo footer. Biarkan ter-comment untuk memakai default. Jangan di-set kosong:
# string kosong tidak memicu fallback `??` di Footer/config.ts, jadi logonya hilang.
# NEXT_PUBLIC_FOOTER_LOGO_URL=https://s3.nevaobjects.id/image-dev/uploads/20260121141804.png
