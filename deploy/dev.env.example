# .env storefront di server dev: /opt/dev-deploy/fe-client-dev/.env, dibaca compose untuk ${...} di
# deploy/docker-compose.dev.yml (container hanya menerima yang ada di `environment:`).
#
# SEMUA konfigurasi app ada di sini, termasuk NEXT_PUBLIC_*: tidak ada yang tertanam di image (lihat
# src/config/runtimeEnv.ts). Mengubahnya cukup jalankan ulang job deploy, atau di folder ini
#   IMAGE_TAG=$(cat .deployed-tag) docker compose up -d
# tanpa build ulang. (Satu-satunya yang build-time: NEXT_PUBLIC_IMAGE_HOSTS, variable GitHub.)
#
# Deploy pertama dengan deploy/deploy.sh membuat file ini sendiri (mode 600) dan mengisinya dengan
# yang dipakai container lama: FE_PUBLISH, NEXT_PUBLIC_API_BASE_URL, NEXT_SITE_BASE_URL,
# ENCRYPT_SECRET_KEY. Sesudah itu tinggal tambahkan yang bertanda [ISI]. Membuatnya sendiri sebelum
# deploy juga boleh: salin file ini, chmod 600, lalu isi baris yang bertanda:
#   [SALIN]  ambil dari container yang sedang jalan, jangan dibuat baru (secret GitHub tidak bisa
#            dibaca lagi):  docker inspect --format '{{range .Config.Env}}{{println .}}{{end}}' fe-client-dev
#   [ISI]    belum ada di container sekarang (dulu tertanam di image saat build, atau belum pernah diisi)
#
# File yang sudah diisi berisi rahasia: jangan di-commit (.gitignore menolak *.env dan .env.*).
# Nilai yang mengandung $, # atau spasi ditulis dalam kutip tunggal, misalnya KEY='a$b#c'.
# Jangan menaruh komentar di belakang nilai (KEY=nilai # komentar); taruh di baris sendiri.

# ---------------------------------------------------------------------------------------------
# Wajib (deploy berhenti sebelum container lama disentuh kalau kosong)
# ---------------------------------------------------------------------------------------------
# URL backend PUBLIK, TANPA /v1 di akhir: browser pembeli dibawa ke sini untuk login & hubungkan
# Google, jadi harus bisa dibuka dari internet. JANGAN isi alamat internal (172.20.x.x): login Google
# mati. Juga dipakai untuk request server kalau API_INTERNAL_URL kosong.
NEXT_PUBLIC_API_BASE_URL=https://dev-api.pakargaming.id
# [SALIN] Domain storefront dev, tanpa / di akhir: URL di sitemap.xml dan header
# X-Forwarded-Origin/Referer yang dikirim proxy ke backend.
NEXT_SITE_BASE_URL=
# [SALIN] "Enkripsi" body browser → /api/proxy. Bukan kontrol keamanan: kuncinya ikut dikirim ke
# browser. Mengganti nilainya membuat tab pembeli yang sudah terbuka perlu di-reload.
# Baru (kalau memang belum pernah ada): openssl rand -hex 32
ENCRYPT_SECRET_KEY=

# ---------------------------------------------------------------------------------------------
# Disarankan
# ---------------------------------------------------------------------------------------------
# [ISI] Backend di network Docker pakargaming-dev, untuk request DARI server ini (proxy /api/proxy,
# sitemap, metadata game, maintenance, logout): tidak memutar lewat internet & nginx. Backend dev ada
# di 172.20.0.10 port 4001 (topup-be: deploy/docker-compose.dev.yml) — PORT WAJIB ditulis (tanpa port =
# port 80 = ECONNREFUSED), tanpa /v1. Kosong = lewat NEXT_PUBLIC_API_BASE_URL.
# SEBELUM diisi: tambahkan 172.20.0.20 (alamat container ini) ke ALLOWED_IPS di
# /opt/dev-deploy/backend-dev/.env lalu restart backend; tanpa itu semua request storefront dijawab 403.
# Log job deploy menulis "Backend answers fe-client-dev at ..." kalau sudah benar.
API_INTERNAL_URL=http://172.20.0.10:4001
# [ISI] Rahasia bersama dengan backend dev: harus SAMA PERSIS dengan STOREFRONT_PROXY_SECRET di
# /opt/dev-deploy/backend-dev/.env. Buat dengan openssl rand -hex 32, isi di sini dan deploy
# storefront dulu, baru isi di backend. Kosong = header X-Storefront-Key tidak dikirim (peringatan
# di log saat start), backend tidak memercayai X-Client-IP dari storefront.
STOREFRONT_PROXY_SECRET=
# [ISI] Cloudflare Turnstile (captcha login/daftar/lupa password), dari widget yang mendaftarkan domain
# storefront dev. Aktif hanya kalau KEDUANYA terisi; salah satu kosong = form tanpa captcha.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------------------------
# Opsional
# ---------------------------------------------------------------------------------------------
# [ISI] Google Analytics 4 (G-XXXXXXXXXX). Kosong = GA tidak dimuat; sebaiknya property terpisah dari prod.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Logo footer (URL gambar https). Kosong = logo + wordmark bawaan.
NEXT_PUBLIC_FOOTER_LOGO_URL=

# ---------------------------------------------------------------------------------------------
# Edge proxy (lihat README, "Edge proxy")
# ---------------------------------------------------------------------------------------------
# Sisi host port mapping, tujuan proxy_pass reverse proxy. Container lama memakai 3000 (semua
# alamat) dan deploy pertama menyalin nilai itu, jadi biarkan ter-comment sampai reverse proxy-nya
# dicek. Kalau reverse proxy ada di server ini (proxy_pass ke 127.0.0.1:3000 atau 172.20.0.20:3000),
# set 127.0.0.1:3000 supaya X-Real-IP tidak bisa dipalsukan dengan menembak port 3000 langsung.
# FE_PUBLISH=127.0.0.1:3000
# Header yang DITIMPA reverse proxy dengan IP pembeli. Default x-real-ip (nginx:
# proxy_set_header X-Real-IP $remote_addr). Caddy: x-forwarded-for.
# CLIENT_IP_HEADER=x-real-ip
